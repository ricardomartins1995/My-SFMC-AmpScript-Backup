%%[/* Control - Relewise - 2x2 Personal Product Recommendations NEWS*/]%%
<script runat="server" language="ampscript">
VAR @productId1, @productId2, @productId3, @productId4, @productId5, @productId6, @productId7, @productId8, @count, @CatId, @type, @Alias, @ShowAdditionalImageIfAvailable, @LookupImageString, @FallbackImageString, @LookupAdditionalImageString,@ProductRecoBlocktype, @EmailName, @SubscriberKey, @CurrentTime, @today, @Rooms, @MaxDropCode

  
  /* KAN ÆNDRES */
SET @blockedMarkets = '' /*Here you can put the CultureCode you want to hide the content and separate with ";". EG: da-DK;de-DE; FI; DK */
SET @trending = ''   /* Here you can input true, false or empty */
SET @bestseller = '' /* Here you can input true, false or empty */
SET @New = '' /* Here you can input true, false or empty */ 
SET @Gift = '' /* Here you can input true, false or empty*/ 
  

SET @DaysCover = '' /*Here you can put values as empty, "Low", "Medium", "High"*/

SET @count = '4' /* Antal produkter der kommer retur fra Relewise */
SET @CatId = '' /*Her sættes kategorien*/
SET @MaxDropCode = ''
SET @Rooms = '' /* Her kan man filtrere på rum. Vælg flere med pipedelimiter "|". */  
SET @BoostIsNews = 'false' /* Her kan I booste på nyheder ved at skruve true */   
SET @ShowAdditionalImageIfAvailable = true
SET @FallbackImageString = 'image'
SET @LookupAdditionalImageString = 'additional image'
SET @ProductRecoBlocktype = 'Personal Product Recommendations NEWS'  /* Manual Product Input, Popular most products viewed etc. */  
SET @BoostByMargin = '0' /* 0 svarer til at der ikke gives et boost, og 5 giver det højeste boost */  
SET @BuryByClaim = '0' /* 0 svarer til at der ikke gives en bury (negativ boost), og 5 giver den højeste bury */
SET @BoostByCartOpener = '0' /* 0 svarer til at der ikke gives et boost, og 5 giver det højeste boost */
SET @FilterIsNews = '' /* For at filtrere på nyeste produkter sættes denne til "True" */
 


  /* KAN ÆNDRES */
  
  /* MÅ IKKE ÆNDRES */
SET @ConfigDE = "Reco-Blokke - Configuration" /* Set template dataextension with values to retrieve */
SET @RelewiseCulture = AttributeValue('Culture')
SET @CountryCodeSC = AttributeValue('Contact:Country_Code__c')
SET @LanguageCodeSC = AttributeValue('Contact:Language_Code__c')
SET @LanguageCodeDE = AttributeValue('LanguageCode')
SET @CountryCodeDE = AttributeValue('CountryCode')
SET @Type = 'PersonalProductRecommendations'
SET @Alias = @Type
SET @isNews = 'true'   

SET @EmailName = emailName_
SET @SubscriberKey = _subscriberkey
Set @today = Now()
SET @CurrentTime = SystemDateToLocalDate(@today)    
  
IF EMPTY(@RelewiseCulture) and EMPTY (@CountryCodeSC) THEN SET @Culture = Concat(@LanguageCodeDE,'-',@CountryCodeDE) 
ELSEIF EMPTY(@RelewiseCulture) and EMPTY (@CountryCodeDE) THEN SET @Culture = Concat(@LanguageCodeSC,'-',@CountryCodeSC)
ELSE SET @Culture = @RelewiseCulture
ENDIF

SET @StCulture = Substring(@culture, SUBTRACT(Length(@culture), 1))

/* Get content blocks */

IF @culture == "da-DK" THEN
SET @ProductFeed = 'ProductFeed-DK'
  
ELSEIF @culture == "de-DE" THEN
SET @ProductFeed = 'ProductFeed-DE'  
  
ELSEIF @culture == "nl-NL" THEN
SET @ProductFeed = 'ProductFeed-NL' 
  
ELSEIF @culture == "sv-SE" THEN
SET @ProductFeed = 'ProductFeed-SE'
  
ELSEIF @culture == "fr-FR" THEN
SET @ProductFeed = 'ProductFeed-FR'
  
ELSEIF @culture == "nb-NO" THEN
SET @ProductFeed = 'ProductFeed-NO'  
  
ELSEIF @culture == "de-AT" THEN
SET @ProductFeed = 'ProductFeed-AT'  
  
ELSEIF @culture == "en-GB" THEN
SET @ProductFeed = 'ProductFeed-GB'  
  
ELSEIF @culture == "en-IE" THEN
SET @ProductFeed = 'ProductFeed-IE'  
  
ELSEIF @culture == "fr-BE" THEN
SET @ProductFeed = 'ProductFeed-BE-fr'  
  
ELSEIF @culture == "nl-BE" THEN
SET @ProductFeed = 'ProductFeed-BE-nl'  
  
ELSEIF @culture == "fr-CH" THEN
SET @ProductFeed = 'ProductFeed-CH-fr'  
  
ELSEIF @culture == "de-CH" THEN
SET @ProductFeed = 'ProductFeed-CH-de'  
  
ELSEIF @culture == 'en-FI' THEN
SET @ProductFeed = 'ProductFeed-IE'

ELSEIF @culture == 'en-ES' THEN
SET @ProductFeed = 'ProductFeed-IE'

ELSEIF @culture == 'is-IS' THEN
SET @ProductFeed = 'ProductFeed-IE'

ENDIF

set @rows = LookupRows(@ConfigDE,"a", "a") 
set @rowCount = rowcount(@rows) 
                                                 
for @counter = 1 to @rowCount do
set @row = row(@rows, @counter) 
set @attributeName = field(@row,"attributename")
set @attributeValue = Lookup(@ConfigDE,@culture,"attributename", @attributeName)
</script>

<script runat="server">
Platform.Load('Core', '1');
 Variable.SetValue('@' + Variable.GetValue("@attributeName"), Variable.GetValue("@attributeValue"));
</script>
<script runat="server" language="ampscript">
next
</script>

<script runat="server" language="ampscript">
SET @EName = Replace(TRIM(emailname_),' ','_')

/*Hent recommendationXML*/

IF EMPTY(@CatId) THEN SET @RequestUrl = Concat("https://cdn.relewise.com/sosg-6ECE2315-FA53-42EA-9B81-1D0605A50432/production/GetRecommendations?email=",emailaddr,"&salesforceId=",_subscriberkey,"&type=",@Type,"&culture=",@Culture,"&count=",@Count,"&boostIsNews=",@isNews,"&BoostByMargin=",@BoostByMargin,"&BuryByClaim=",@BuryByClaim,"&BoostByCartOpener=",@BoostByCartOpener,"&MaxDropCode=",@MaxDropCode,'&Room=',@Rooms,'&BoostIsNews=',@BoostIsNews,'&EName=',@EName,"&FilterIsNews=",@FilterIsNews,'&Filtertrending=',@trending,'&Filterbestseller=',@bestseller,'&DaysCoverageGroup=',@DaysCover)
ELSE SET @RequestUrl = Concat("https://cdn.relewise.com/sosg-6ECE2315-FA53-42EA-9B81-1D0605A50432/production/GetRecommendations?email=",emailaddr,"&salesforceId=",_subscriberkey,"&type=",@Type,"&culture=",@Culture,"&count=",@Count,"&categoryId=",@CatId,"&boostIsNews=",@isNews,"&BoostByMargin=",@BoostByMargin,"&BuryByClaim=",@BuryByClaim,"&BoostByCartOpener=",@BoostByCartOpener,"&MaxDropCode=",@MaxDropCode,'&Room=',@Rooms,'&BoostIsNews=',@BoostIsNews,'&EName=',@EName,"&FilterIsNews=",@FilterIsNews,'&Filtertrending=',@trending,'&Filterbestseller=',@bestseller,'&DaysCoverageGroup=',@DaysCover) 
ENDIF


SET @RecoXML = HTTPGet(@RequestUrl)             
  
/*henter Produkter fra Recoxml*/                                            
SET @productRows = BuildRowSetFromXML(@RecoXML, "Response/Recommendations/Recommendation", 0)
                                      
                                      

for @j = 1 to RowCount(@productRows) do 
SET @productXML = Concat("<product>", Field(Row(@productRows, @j), "XML"), "</product>") 

IF rowcount(BuildRowSetFromXML(@productXML,"/product/VariantId", 0)) > 0 THEN  /*Check om Relewise sender variantId med*/
SET @productId = Trim(Field(Row(BuildRowSetFromXML(@productXML,"/product/VariantId", 0), 1),"Value"))
ELSE  /*Hvis ikke Relewise kender variantId bruger vi productid til at lave lookup i productfeed*/
SET @productId = Lookup(@ProductFeed,'ID','item group id',Trim(Field(Row(BuildRowSetFromXML(@productXML,"/product/ProductId", 0), 1),"Value")))
ENDIF                      
                           
IF rowcount(lookuprows(@ProductFeed,'ID',@productId)) > 0 THEN 

        IF empty(@productId1) THEN SET @productId1 = @ProductId
            ELSEIF empty(@productId2) THEN SET @productId2 = @ProductId
            ELSEIF empty(@productId3) THEN SET @productId3 = @ProductId
            ELSEIF empty(@productId4) THEN SET @productId4 = @ProductId 
            ELSEIF empty(@productId5) THEN SET @productId5 = @ProductId          
            ELSEIF empty(@productId6) THEN SET @productId6 = @ProductId 
            ELSEIF empty(@productId7) THEN SET @productId7 = @ProductId 
            ELSEIF empty(@productId8) THEN SET @productId8 = @ProductId 
        ENDIF

    ELSE
        InsertDE("empty_productrecs_log","SubscriberKey",@SubscriberKey,"RecProductId",@productId,"RecProductXML",@productXML,"ProductRecoBlocktype",@ProductRecoBlocktype,"EmailName",@EmailName,"Timestamp",@CurrentTime)
    
ENDIF                                    
  
</script>


<script runat="server" language="ampscript">
NEXT @j
</script>

<script runat="server" language="ampscript">
  
/* Set which image to lookup */
IF @ShowAdditionalImageIfAvailable THEN 
  SET @LookupImageString = @LookupAdditionalImageString
ELSE 
  SET @LookupImageString = @FallbackImageString
ENDIF

/* Set productdata to display - product 1 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId1)) THEN 
  SET @productImage1 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId1)
ELSE 
  SET @productImage1 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId1)
ENDIF
SET @productLink1 = Lookup(@ProductFeed,'link','ID',@productId1)
SET @productTitle1 = Lookup(@ProductFeed,'title','ID',@productId1)
SET @productPrice1 = replace(Lookup(@ProductFeed,'price','ID',@productId1),".",",")

/* Set productdata to display - product 2 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId2)) THEN 
  SET @productImage2 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId2)
ELSE 
  SET @productImage2 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId2)
ENDIF
SET @productLink2 = Lookup(@ProductFeed,'link','ID',@productId2)
SET @productTitle2 = Lookup(@ProductFeed,'title','ID',@productId2)
SET @productPrice2 = replace(Lookup(@ProductFeed,'price','ID',@productId2),".",",")

/* Set productdata to display - product 3 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId3)) THEN 
  SET @productImage3 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId3)
ELSE 
  SET @productImage3 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId3)
ENDIF
SET @productLink3 = Lookup(@ProductFeed,'link','ID',@productId3)
SET @productTitle3 = Lookup(@ProductFeed,'title','ID',@productId3)
SET @productPrice3 = replace(Lookup(@ProductFeed,'price','ID',@productId3),".",",")

/* Set productdata to display - product 4 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId4)) THEN 
  SET @productImage4 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId4)
ELSE 
  SET @productImage4 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId4)
ENDIF
SET @productLink4 = Lookup(@ProductFeed,'link','ID',@productId4)
SET @productTitle4 = Lookup(@ProductFeed,'title','ID',@productId4)
SET @productPrice4 = replace(Lookup(@ProductFeed,'price','ID',@productId4),".",",")

/* Set productdata to display - product 5 */                             
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId5)) THEN 
  SET @productImage5 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId5)
ELSE 
  SET @productImage5 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId5)
ENDIF
SET @productLink5 = Lookup(@ProductFeed,'link','ID',@productId5)
SET @productTitle5 = Lookup(@ProductFeed,'title','ID',@productId5)
SET @productPrice5 = replace(Lookup(@ProductFeed,'price','ID',@productId5),".",",")

/* Set productdata to display - product 6 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId6)) THEN 
  SET @productImage6 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId6)
ELSE 
  SET @productImage6 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId6)
ENDIF
SET @productLink6 = Lookup(@ProductFeed,'link','ID',@productId6)
SET @productTitle6 = Lookup(@ProductFeed,'title','ID',@productId6)
SET @productPrice6 = replace(Lookup(@ProductFeed,'price','ID',@productId6),".",",")

/* Set productdata to display - product 7 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId7)) THEN 
  SET @productImage7 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId7)
ELSE 
  SET @productImage7 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId7)
ENDIF
SET @productLink7 = Lookup(@ProductFeed,'link','ID',@productId7)
SET @productTitle7 = Lookup(@ProductFeed,'title','ID',@productId7)
SET @productPrice7 = replace(Lookup(@ProductFeed,'price','ID',@productId7),".",",")

/* Set productdata to display - product 8 */
IF EMPTY(Lookup(@ProductFeed,@LookupImageString,'ID',@productId8)) THEN 
  SET @productImage8 = Lookup(@ProductFeed,@FallbackImageString,'ID',@productId8)
ELSE 
  SET @productImage8 = Lookup(@ProductFeed,@LookupImageString,'ID',@productId8)
ENDIF
SET @productLink8 = Lookup(@ProductFeed,'link','ID',@productId8)
SET @productTitle8 = Lookup(@ProductFeed,'title','ID',@productId8)
SET @productPrice8 = replace(Lookup(@ProductFeed,'price','ID',@productId8),".",",")
  
/*Verify if the product have Trending, BestSeller, New or Gift Flag*/
IF @New == 'True' THEN  
    FOR @CNT3 = 1 TO 8 DO
        SET @FIELDSET = TreatAsContent(CONCAT('%','%[SET @FLAGVALUE', @CNT3,'=LOOKUP("Reco-Block_trending&bestseller_Filter", @culture, "attributename", "New")]%','%'))
        SET @FIELDSET4 = TreatAsContent(CONCAT('%','%[SET @BGCOLOR',@CNT3,'= "#F6F3E8"]%','%'))
        SET @FIELDSET5 = TreatAsContent(CONCAT('%','%[SET @COLOR',@CNT3,'= "#504139"]%','%'))
    NEXT @CNT3
ELSEIF @Gift == 'True' THEN
    FOR @CNT3 = 1 TO 8 DO
        SET @FIELDSET = TreatAsContent(CONCAT('%','%[SET @FLAGVALUE', @CNT3,'=LOOKUP("Reco-Block_trending&bestseller_Filter", @culture, "attributename","Gift")]%','%'))
        SET @FIELDSET4 = TreatAsContent(CONCAT('%','%[SET @BGCOLOR',@CNT3,'= "#F6F3E8"]%','%'))
        SET @FIELDSET5 = TreatAsContent(CONCAT('%','%[SET @COLOR',@CNT3,'= "#504139"]%','%'))
    NEXT @CNT3
ELSE
    SET @ARRAYTREND = ''
    SET @ARRAYBEST = ''
    FOR @CNT=1 TO 8 DO
        SET @FIELDSET1 = TreatAsContent(CONCAT('%','%[SET @TREND',@CNT,' = LOOKUP(@ProductFeed,"Trending","ID",@productId',@CNT,')]%','%'))
        SET @FIELDSET2 = TreatAsContent(CONCAT('%','%[SET @BEST',@CNT,' = LOOKUP(@ProductFeed,"Bestseller","ID",@productId',@CNT,')]%','%'))
        IF @CNT < 8 THEN    
            SET @ARRAY1CNT = TreatAsContent(CONCAT('%','%[SET @ARRAYTREND = CONCAT(@ARRAYTREND, @TREND',@CNT,',"/")]%','%'))
            SET @ARRAY2CNT = TreatAsContent(CONCAT('%','%[SET @ARRAYBEST = CONCAT(@ARRAYBEST, @BEST',@CNT,',"/")]%','%'))
        ELSE
            SET @ARRAY1CNT = TreatAsContent(CONCAT('%','%[SET @ARRAYTREND = CONCAT(@ARRAYTREND, @TREND',@CNT,')]%','%'))
            SET @ARRAY2CNT = TreatAsContent(CONCAT('%','%[SET @ARRAYBEST = CONCAT(@ARRAYBEST, @BEST',@CNT,')]%','%'))
        ENDIF
    NEXT @CNT

    SET @ARRAYTREND2 = BuildRowsetFromString(@ARRAYTREND,"/")  
    SET @ARRAYTRENDCOUNT = ROWCOUNT(@ARRAYTREND2)
    SET @ARRAYBEST2 = BuildRowsetFromString(@ARRAYBEST,"/")  
    SET @ARRAYBESTCOUNT = ROWCOUNT(@ARRAYBEST2)

    FOR @CNT2 = 1 TO 8 DO

        SET @ROWTREND = ROW(@ARRAYTREND2, @CNT2)
        SET @ROWBEST = ROW(@ARRAYBEST2, @CNT2)

        SET @TEMPTREND = FIELD(@ROWTREND, 1)
        SET @TEMPBEST = FIELD(@ROWBEST, 1)

        IF (@TEMPTREND == 'True' AND @TEMPBEST == 'True') OR (@TEMPTREND == 'True' AND @TEMPBEST == 'False') THEN
            SET @FIELDSET3 = TreatAsContent(CONCAT('%','%[SET @FLAGVALUE',@CNT2,'= LOOKUP("Reco-Block_trending&bestseller_Filter", @culture, "attributename","Trending")]%','%'))
            SET @FIELDSET4 = TreatAsContent(CONCAT('%','%[SET @BGCOLOR',@CNT2,'= "#F6F3E8"]%','%'))
            SET @FIELDSET5 = TreatAsContent(CONCAT('%','%[SET @COLOR',@CNT2,'= "#504139"]%','%'))
        ELSEIF @TEMPBEST == 'True' AND @TEMPTREND == 'False' THEN
            SET @FIELDSET3 = TreatAsContent(CONCAT('%','%[SET @FLAGVALUE',@CNT2,'= LOOKUP("Reco-Block_trending&bestseller_Filter", @culture, "attributename","Bestseller")]%','%'))
            SET @FIELDSET4 = TreatAsContent(CONCAT('%','%[SET @BGCOLOR',@CNT2,'= "#F6F3E8"]%','%'))
            SET @FIELDSET5 = TreatAsContent(CONCAT('%','%[SET @COLOR',@CNT2,'= "#504139"]%','%'))
        ENDIF
    NEXT @CNT2
ENDIF

  /* MÅ IKKE ÆNDRES */  
</script>

